{
  "type": "soap",
  "name": "get-account-fault",
  "match": {
    "soapAction": "GetAccount",
    "operation": "GetAccount",
    "xpath": "//*[local-name()='AccountId' and text()='999']"
  },
  "response": {
    "statusCode": 500,
    "contentType": "text/xml",
    "delayMs": 250,
    "body": "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body><s:Fault><faultstring>Account not found</faultstring></s:Fault></s:Body></s:Envelope>"
  }
}
