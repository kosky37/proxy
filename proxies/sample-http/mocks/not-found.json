{
  "type": "rest",
  "name": "not-found",
  "match": {
    "methods": [
      "GET",
      "POST",
      "PUT"
    ],
    "path": "/missing",
    "pathMode": "exact"
  },
  "response": {
    "statusCode": 404,
    "contentType": "application/json",
    "body": "{ \u0022error\u0022: \u0022not found\u0022 }",
    "delayMs": 0,
    "block": false
  },
  "fileName": "",
  "enabled": true
}